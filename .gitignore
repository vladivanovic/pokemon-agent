# Pokemon Red Agent .gitignore

# SB3 checkpoints and logs
*.zip
v2/runs/
explore_map_union*.json
action.json
reasoning.json
special_tiles.json
init.state

# Backup files
*.backup
*.bak
*.orig
*.tmp
*.working
*_fix*
*_before_*
*_after_*
*.patch
*.live*

# Python cache
__pycache__
*.py[cod]
*$py.class

# Distribution / build
*.egg-info/

# New agent runtime state (episodic memory logs etc.)
.pokemon-agent/
build/
dist/

# Hermes agent data (optional)
# .hermes/

# ROM files
*.gb
*.gbc

# OS
.DS_Store
Thumbs.db

# Training datasets (generated from game ROM data — not for redistribution)
dataset/
