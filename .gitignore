# Pokemon Red Agent .gitignore

# SB3 checkpoints and logs
*.zip
v2/runs/
explore_map_union*.json
action.json
reasoning.json
special_tiles.json
init.state

# Backup files
*.backup
*.bak
*.orig
*.tmp
*.working
*_fix*
*_before_*
*_after_*
*.patch
*.live*

# Python cache
__pycache__
*.py[cod]
*$py.class

# Distribution / build
.pokemon_agent.egg-info/
build/
dist/

# Hermes agent data (optional)
# .hermes/

# ROM files
*.gb
*.gbc

# OS
.DS_Store
Thumbs.db
